{
  "1": {
    "inputs": {
      "image": "PLACEHOLDER_IMAGE"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "First/Last Frame Image" }
  },
  "2": {
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load H3 FL2VA" }
  },
  "3": {
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Qwen3-VL" }
  },
  "4": {
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load H3 Video VAE" }
  },
  "5": {
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load H3 Audio VAE" }
  },
  "6": {
    "inputs": {
      "model": ["2", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Turbo 8-step LoRA" }
  },
  "7": {
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "first_frame": ["1", 0],
      "last_frame": ["1", 0],
      "prompt": "PLACEHOLDER_POSITIVE",
      "width": 1344,
      "height": 768,
      "length": 124
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": { "title": "H3 FL2V Encode (start=end)" }
  },
  "8": {
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "class_type": "KSamplerSelect",
    "_meta": { "title": "Sampler" }
  },
  "9": {
    "inputs": {
      "noise_seed": 777
    },
    "class_type": "RandomNoise",
    "_meta": { "title": "Noise Seed" }
  },
  "10": {
    "inputs": {
      "model": ["6", 0],
      "conditioning": ["7", 0]
    },
    "class_type": "BasicGuider",
    "_meta": { "title": "Guider" }
  },
  "11": {
    "inputs": {
      "model": ["6", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    },
    "class_type": "BasicScheduler",
    "_meta": { "title": "Scheduler" }
  },
  "12": {
    "inputs": {
      "noise": ["9", 0],
      "guider": ["10", 0],
      "sampler": ["8", 0],
      "sigmas": ["11", 0],
      "latent_image": ["7", 1]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "Sample Joint AV Latent" }
  },
  "13": {
    "inputs": {
      "samples": ["12", 0],
      "vae": ["4", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Video" }
  },
  "14": {
    "inputs": {
      "samples": ["12", 0],
      "vae": ["5", 0]
    },
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "Decode Audio" }
  },
  "15": {
    "inputs": {
      "images": ["13", 0],
      "audio": ["14", 0],
      "fps": 24
    },
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video (24fps + audio)" }
  },
  "16": {
    "inputs": {
      "video": ["15", 0],
      "filename_prefix": "video/ComfyUI",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video" }
  }
}
